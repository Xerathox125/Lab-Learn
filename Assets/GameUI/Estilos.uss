.button {
    margin-left: 0;
    width: 165px;
    height: 200px;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
}

.text {
    align-items: center;
    color: rgb(255, 255, 255);
    font-size: 40px;
    -unity-text-align: upper-center;
    -unity-font-style: bold;
}

.button:hover {
    scale: 1.1 1.1;
}

.button:active {
    -unity-background-image-tint-color: rgb(19, 74, 190);
}
